index 0000000..be34dcb
--- /dev/null
+++ b/toolkit_core/toolkit_core/security.py
@@ -0,0 +1,10 @@
+import hashlib
+import secrets
+
+
+def generate_raw_token() -> str:
+    return secrets.token_urlsafe(32)
+
+
+def hash_value(raw: str) -> str:
+    return hashlib.sha256(raw.encode()).hexdigest()
